<VBox fx:controller="mapademo.controllers.SessionsController" stylesheets="@../../resources/estilos.css" xmlns="http://javafx.com/javafx/21.0.10" xmlns:fx="http://javafx.com/fxml/1" spacing="10.0" styleClass="content-panel">
                            <children>
                                <TableView fx:id="sessionTableView" prefHeight="420.0">
                                    <columns>
                                        <TableColumn fx:id="sessionStartColumn" prefWidth="170.0" text="Inicio" />
                                        <TableColumn fx:id="sessionEndColumn" prefWidth="170.0" text="Fin" />
                                        <TableColumn fx:id="sessionDurationColumn" prefWidth="120.0" text="Duracion" />
                                        <TableColumn fx:id="sessionImportedColumn" prefWidth="90.0" text="Importadas" />
                                        <TableColumn fx:id="sessionViewedColumn" prefWidth="90.0" text="Vistas" />
                                        <TableColumn fx:id="sessionAnnotationsColumn" prefWidth="95.0" text="Anotaciones" />
                                    </columns>
                                </TableView>
                                <GridPane hgap="10.0" vgap="6.0">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="150.0" />
                                        <ColumnConstraints minWidth="150.0" />
                                        <ColumnConstraints minWidth="150.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label fx:id="sessionTotalCountLabel" text="Sesiones: 0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <Label fx:id="sessionTotalDurationLabel" text="Tiempo total: 00:00:00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <Label fx:id="sessionTotalImportedLabel" text="Importadas: 0" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                        <Label fx:id="sessionTotalViewedLabel" text="Vistas: 0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <Label fx:id="sessionTotalAnnotationsLabel" text="Anotaciones: 0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    </children>
                                </GridPane>
                            </children>
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                        </VBox>




