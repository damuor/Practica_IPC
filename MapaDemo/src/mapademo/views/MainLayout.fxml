<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="app-root" stylesheets="@../../resources/estilos.css" xmlns="http://javafx.com/javafx/21.0.10" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mapademo.controllers.MainLayoutController">
    <left>
        <VBox fx:id="navigationPane" spacing="8.0" styleClass="side-panel">
            <children>
                <Label fx:id="viewsTitleLabel" styleClass="section-title" text="Vistas" />
                <Button fx:id="navActivitiesButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showActivitiesView" styleClass="secondary-button" text="Actividades" />
                <Button fx:id="navProfileButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showProfileView" styleClass="secondary-button" text="Perfil" />
                <Button fx:id="navSessionsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showSessionsView" styleClass="secondary-button" text="Sesiones" />
                <Button fx:id="navMapsButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#showMapsView" styleClass="secondary-button" text="Mapas" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
