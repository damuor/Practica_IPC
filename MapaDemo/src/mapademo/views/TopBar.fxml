<?import javafx.scene.layout.VBox?>
        <VBox fx:controller="mapademo.controllers.TopBarController" stylesheets="@../../resources/estilos.css" xmlns="http://javafx.com/javafx/21.0.10" xmlns:fx="http://javafx.com/fxml/1" styleClass="top-region">
            <children>
                <MenuBar fx:id="mainMenuBar" styleClass="app-menu">
                    <menus>
                        <Menu fx:id="fileMenu" mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem fx:id="importActivityMenuItem" mnemonicParsing="false" onAction="#onImportActivity" text="Importar GPX" />
                                <SeparatorMenuItem mnemonicParsing="false" />
                                <MenuItem fx:id="logoutMenuItem" mnemonicParsing="false" onAction="#onLogout" text="Cerrar sesión" />
                                <MenuItem fx:id="exitMenuItem" mnemonicParsing="false" onAction="#onExit" text="Salir" />
                            </items>
                        </Menu>
                        <Menu fx:id="activityMenu" mnemonicParsing="false" text="Actividad">
                            <items>
                                <MenuItem fx:id="renameActivityMenuItem" mnemonicParsing="false" onAction="#onRenameActivity" text="Renombrar actividad" />
                                <MenuItem fx:id="removeActivityMenuItem" mnemonicParsing="false" onAction="#onRemoveActivity" text="Borrar actividad" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-toolbar">
                    <children>
                        <Label styleClass="brand-title" text="Running la Safor - IPC 2026" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ImageView fx:id="currentAvatarImageView" fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true" styleClass="avatar-image" />
                        <Label fx:id="userTextLabel" text="Usuario:" />
                        <Label fx:id="currentUserLabel" styleClass="user-name" text="No autenticado" />
                        <Label fx:id="languageTextLabel" text="Idioma:" />
                        <ComboBox fx:id="languageComboBox" prefWidth="118.0" styleClass="language-combo" />
                        <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onLogin" styleClass="primary-button" text="Iniciar sesión" />
                        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#onRegister" styleClass="secondary-button" text="Registrarse" />
                        <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogout" styleClass="secondary-button" text="Cerrar sesión" />
                    </children>
                    <padding>
                        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                    </padding>
                </HBox>
                <Label fx:id="statusLabel" minHeight="36.0" styleClass="status-label" text="Estado: listo." wrapText="true">
                    <padding>
                        <Insets bottom="8.0" left="12.0" right="12.0" />
                    </padding>
                </Label>
            </children>
        </VBox>




